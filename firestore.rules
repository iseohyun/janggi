rules_version = '2';

// =====================================================================
// 웹장기 온라인 대국 Firestore 보안 규칙 초안 (아직 배포하지 않음)
//
//  - 데이터: games/janggi/rooms/{roomId}
//            games/janggi/rooms/{roomId}/moves/{ply}   (ply = 0부터 세는 수 번호, 문서 id = 그 숫자)
//            games/janggi/rooms/{roomId}/chat/{자동 id}
//            games/janggi/lobby/{roomId}   (공개 방 요약, Cloud Functions syncLobby만 씀, 누구나 읽음)
//  - 앱 코드: module/online/firebase-backend.js, online-core.js
//  - 이 Firebase 프로젝트(any-match-hub)는 다른 게임과 함께 쓸 수 있다.
//    Firestore 규칙은 데이터베이스마다 파일이 하나뿐이므로, 다른 게임 규칙이 이미 있으면
//    아래 "match /games/janggi/..." 부분만 그 파일의 match /databases/{database}/documents { } 안에 합쳐서 배포한다.
//    (그대로 배포하면 다른 게임의 규칙을 덮어쓴다!)
//  - 서버는 장기 규칙(기물 움직임)을 검사하지 않는다. 받는 쪽 앱이 기존 규칙 검사로 거부한다.
//    여기서는 "누가·언제·몇 번째 수를" 쓰는지만 지킨다.
//  - 시간패·외통 결과는 양쪽 앱이 보내는 값을 믿는다 (규칙으로 시계를 검증할 수 없음).
//  - 로그인 = Google 로그인 또는 이메일 승인형 로그인(Cloud Functions가 이메일 인증된 사용자로 custom token을 내줌).
//    두 방식 모두 이메일이 확인된 사용자이므로 "인증 전 사용자" 구분은 없다. 그래도 규칙은 email_verified를 확인한다
//    (콘솔에서 다른 로그인 방식이 켜져 있어도 확인 안 된 계정은 못 쓰게).
//  - 모든 기기에서 로그아웃: Cloud Functions revokeAllSessions가 games/janggi/users/{uid}.revokedAt(초)을 남긴다.
//    그 전에 로그인한 ID 토큰(auth_time < revokedAt)은 남은 유효 시간(최대 1시간) 동안에도 여기서 막힌다.
//    이 확인 때문에 요청마다 users 문서 읽기가 한 번 더 든다 (같은 요청 안에서는 한 번만 셈).
//  - games/janggi/loginRequests·loginEmails·loginIps(로그인 요청·남용 방지 기록)는 Cloud Functions(Admin SDK)만 읽고 쓴다.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function me() {
      return request.auth.uid;
    }

    // 모든 기기에서 로그아웃한 뒤의 옛 토큰이 아님
    function notRevoked() {
      let u = /databases/$(database)/documents/games/janggi/users/$(request.auth.uid);
      return !exists(u) || request.auth.token.auth_time >= get(u).data.get('revokedAt', 0);
    }

    // 로그인한 사용자: 이메일이 확인되었고(Google·이메일 승인형 모두 해당) 로그아웃 처리된 토큰이 아님
    function signedIn() {
      return request.auth != null
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'google.com')
        && notRevoked();
    }

    function sideOf(ply) {
      return ply % 2 == 0 ? 'cho' : 'han';
    }

    function otherSide(side) {
      return side == 'cho' ? 'han' : 'cho';
    }

    function coord(v, min) {
      return v is int && v >= min && v <= 9;
    }

    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 40;
    }

    function roomDoc(database, roomId) {
      return /databases/$(database)/documents/games/janggi/rooms/$(roomId);
    }

    match /games/janggi/rooms/{roomId} {

      function isMember() {
        return signedIn() && me() in resource.data.members;
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function mySide() {
        return resource.data.seats.cho != null && resource.data.seats.cho.uid == me() ? 'cho' : 'han';
      }

      // 대국 중에 바뀌면 안 되는 칸 (방 설정은 시작 전에만 hostSetup·guestSetup으로)
      function fixedKept(ch) {
        return !ch.hasAny(['app', 'v', 'hostUid', 'createdAtMs', 'createdAt', 'charim',
                                  'timeLimitMin', 'sidePick', 'members', 'seats', 'visibility', 'ready']);
      }

      function isHost() {
        return signedIn() && resource.data.hostUid == me();
      }

      function isGuest() {
        return isMember() && resource.data.hostUid != me();
      }

      // 자리 묶음 seats에서 uid가 앉은 진영
      function sideOfUid(seats, uid) {
        return seats.cho != null && seats.cho.uid == uid ? 'cho' : 'han';
      }

      function validCharim(c) {
        return c is int && c >= 0 && c <= 3;
      }

      function charimShape(c) {
        return c.keys().hasOnly(['cho', 'han']) && c.keys().hasAll(['cho', 'han']);
      }

      function moveDocAfter(ply) {
        return existsAfter(/databases/$(database)/documents/games/janggi/rooms/$(roomId)/moves/$(string(ply)));
      }

      // 읽기: 참가자, 또는 초대 링크로 들어오려는 로그인 사용자(기다리는 방만). 없는 방(resource == null)은 "없음"을 알 수 있게.
      // 목록 조회(list)는 막는다 → 방 코드를 모르면 찾을 수 없다.
      allow get: if signedIn() && (resource == null || me() in resource.data.members || resource.data.status == 'waiting');
      allow list: if false;

      // 방 만들기: 내가 방장이고 한 자리에만 앉는다
      allow create: if signedIn()
        && roomId.matches('^[A-Z0-9]{6,16}$')
        && request.resource.data.app == 'janggi'
        && request.resource.data.hostUid == me()
        && request.resource.data.members == [me()]
        && request.resource.data.status == 'waiting'
        && request.resource.data.ply == 0
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.ready == false
        && charimShape(request.resource.data.charim)
        && request.resource.data.undo == null
        && request.resource.data.result == null
        && request.resource.data.timeLimitMin is int
        && request.resource.data.timeLimitMin >= 0 && request.resource.data.timeLimitMin <= 180
        && request.resource.data.charim.cho is int && request.resource.data.charim.cho >= 0 && request.resource.data.charim.cho <= 3
        && request.resource.data.charim.han is int && request.resource.data.charim.han >= 0 && request.resource.data.charim.han <= 3
        && ((request.resource.data.seats.han == null && request.resource.data.seats.cho.uid == me()
              && validName(request.resource.data.seats.cho.name))
            || (request.resource.data.seats.cho == null && request.resource.data.seats.han.uid == me()
              && validName(request.resource.data.seats.han.name)));

      // 입장: 참가자가 아닌 사람이 기다리는 방의 빈 자리에 자기를 앉힌다 (대국 시작은 방장이 hostStart로)
      function joining() {
        let side = resource.data.seats.cho == null ? 'cho' : 'han';
        return resource.data.status == 'waiting'
          && resource.data.seats[side] == null
          && signedIn()
          && !(me() in resource.data.members)
          && changed().hasOnly(['seats', 'members'])
          && request.resource.data.members == resource.data.members.concat([me()])
          && request.resource.data.seats[side].uid == me()
          && validName(request.resource.data.seats[side].name)
          && request.resource.data.seats[otherSide(side)] == resource.data.seats[otherSide(side)];
      }

      // 참가자가 바꿀 수 있는 것
      function memberUpdate() {
        let o = resource.data;
        let d = request.resource.data;
        let ch = d.diff(o).affectedKeys();
        return isMember() && fixedKept(ch) && (
          // ① 수 하나 두기: 자기 차례의 자리 주인이, moves/{ply} 문서와 함께 (한 트랜잭션)
          (o.status == 'playing'
            && d.ply == o.ply + 1
            && o.seats[sideOf(o.ply)].uid == me()
            && moveDocAfter(o.ply)
            && ch.hasOnly(['ply', 'clock', 'lastMoveAtMs', 'undo', 'status', 'result'])
            && d.undo == null
            && (d.status == 'playing'
                || (d.status == 'ended' && d.result.reason == 'checkmate'
                    && d.result.winner == mySide() && d.result.by == me())
                // 연속 한수쉼(초·한이 잇달아 한수쉼): 점수 승(cho·han) 또는 비김(null)
                || (d.status == 'ended' && d.result.reason == 'doublePass'
                    && (d.result.winner == null || d.result.winner in ['cho', 'han'])
                    && d.result.by == me())))
          // ② 무르기 받아들이기: 상대가 청한 무르기를, 마지막 수 문서를 지우면서
          || (o.status == 'playing'
            && o.undo != null && o.undo.by != me() && o.undo.ply == o.ply
            && d.ply == o.ply - 1
            && !moveDocAfter(o.ply - 1)
            && ch.hasOnly(['ply', 'undo', 'lastMoveAtMs'])
            && d.undo == null)
          // ③ 무르기 청하기: 방금 둔 내 수만
          || (o.status == 'playing'
            && o.undo == null && o.ply > 0
            && o.seats[sideOf(o.ply - 1)].uid == me()
            && ch.hasOnly(['undo'])
            && d.undo.by == me() && d.undo.ply == o.ply)
          // ④ 무르기 거절: 상대가 청한 것을 지운다
          || (o.undo != null && o.undo.by != me()
            && ch.hasOnly(['undo'])
            && d.undo == null)
          // ⑤ 대국 끝: 기권(내가 짐)·시간패
          || (o.status == 'playing' && d.status == 'ended'
            && ch.hasOnly(['status', 'result', 'clock', 'undo'])
            && d.result.by == me()
            && ((d.result.reason == 'resign' && d.result.winner == otherSide(mySide()))
                || (d.result.reason == 'timeout' && d.result.winner in ['cho', 'han'])))
          // ⑥ 방장이 상대를 기다리던 방 닫기
          || (o.status == 'waiting' && o.hostUid == me()
            && d.status == 'closed'
            && ch.hasOnly(['status']))
        );
      }

      // ----- 시작 전 방 설정 (status == 'waiting') -----

      // 상대: 자기 상차림과 준비만. 상차림을 바꾸면 준비가 풀린다 (같은 쓰기에 ready=false)
      function guestSetup() {
        let o = resource.data;
        let d = request.resource.data;
        let s = sideOfUid(o.seats, me());
        return o.status == 'waiting' && isGuest()
          && d.diff(o).affectedKeys().hasOnly(['charim', 'ready'])
          && charimShape(d.charim)
          && d.charim[otherSide(s)] == o.charim[otherSide(s)]
          && validCharim(d.charim[s])
          && d.ready is bool
          && (d.charim[s] == o.charim[s] || d.ready == false);
      }

      // 상대: 시작 전에 자리에서 일어나기 (방은 다시 빈 자리가 생김)
      function guestLeave() {
        let o = resource.data;
        let d = request.resource.data;
        let s = sideOfUid(o.seats, me());
        return o.status == 'waiting' && isGuest()
          && d.diff(o).affectedKeys().hasOnly(['seats', 'members', 'ready'])
          && d.members == [o.hostUid]
          && d.seats[s] == null
          && d.seats[otherSide(s)] == o.seats[otherSide(s)]
          && d.ready == false;
      }

      // 방장: 자기 상차림·진영(자리 맞바꾸기)·제한 시간. 바꾸면 상대의 준비가 풀린다 (ready=false)
      // 진영을 바꾸면 상대 자리와 상대 상차림이 함께 옮겨 간다 (상대 상차림 값은 그대로)
      function hostSetup() {
        let o = resource.data;
        let d = request.resource.data;
        let hs = sideOfUid(o.seats, me());
        let hs2 = sideOfUid(d.seats, me());
        return o.status == 'waiting' && isHost()
          && d.diff(o).affectedKeys().hasOnly(['charim', 'timeLimitMin', 'sidePick', 'seats', 'ready'])
          && d.ready == false
          && ((d.seats.cho == o.seats.cho && d.seats.han == o.seats.han)
              || (d.seats.cho == o.seats.han && d.seats.han == o.seats.cho))
          && d.seats[hs2] != null && d.seats[hs2].uid == me()
          && charimShape(d.charim)
          && d.charim[otherSide(hs2)] == o.charim[otherSide(hs)]
          && validCharim(d.charim[hs2])
          && d.timeLimitMin is int && d.timeLimitMin >= 0 && d.timeLimitMin <= 180
          && d.sidePick in ['cho', 'han', 'random'];
      }

      // 방장: 상대가 준비한 뒤에만 대국 시작
      function hostStart() {
        let o = resource.data;
        let d = request.resource.data;
        return o.status == 'waiting' && isHost()
          && o.ready == true
          && o.members.size() == 2
          && o.seats.cho != null && o.seats.han != null
          && d.diff(o).affectedKeys().hasOnly(['status', 'startedAtMs', 'lastMoveAtMs'])
          && d.status == 'playing';
      }

      // 시작 전 설정 규칙은 기다리는 방에서만 따진다 (대국 중 수 두기가 식 개수 한도 1000에 걸리지 않게)
      allow update: if (resource.data.status == 'waiting'
                        && (joining() || guestSetup() || guestLeave() || hostSetup() || hostStart()))
                    || memberUpdate();
      allow delete: if false;

      // ----- 수 -----
      match /moves/{moveId} {
        function room() {
          return get(roomDoc(database, roomId)).data;
        }

        function roomAfter() {
          return getAfter(roomDoc(database, roomId)).data;
        }

        // 공개 방의 수는 누구나(로그인 없이) 관전용으로 읽는다. 비공개 방은 참가자만
        allow read: if room().get('visibility', 'private') == 'public'
          || (signedIn() && me() in room().members);

        // 자기 차례에 자기 수만, 방의 수 번호를 하나 올리면서
        allow create: if signedIn()
          && me() in room().members
          && room().status == 'playing'
          && room().seats[sideOf(room().ply)].uid == me()
          && moveId == string(room().ply)
          && request.resource.data.ply == room().ply
          && request.resource.data.by == me()
          && roomAfter().ply == room().ply + 1
          && coord(request.resource.data.fx, 1) && coord(request.resource.data.fy, 0)
          && coord(request.resource.data.tx, 1) && coord(request.resource.data.ty, 0)
          && request.resource.data.keys().hasOnly(['ply', 'by', 'fx', 'fy', 'tx', 'ty', 'clock', 'atMs', 'at']);

        // 무르기 받아들이기: 상대가 청한 마지막 수만, 방 수 번호를 하나 내리면서
        allow delete: if signedIn()
          && me() in room().members
          && room().undo != null && room().undo.by != me()
          && moveId == string(room().ply - 1)
          && roomAfter().ply == room().ply - 1;

        allow update: if false;
      }

      // ----- 채팅 -----
      match /chat/{msgId} {
        function room() {
          return get(roomDoc(database, roomId)).data;
        }

        allow read: if signedIn() && me() in room().members;

        allow create: if signedIn()
          && me() in room().members
          && request.resource.data.uid == me()
          && request.resource.data.kind in ['user', 'system']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && validName(request.resource.data.name)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'side', 'text', 'kind', 'atMs', 'at']);

        allow update, delete: if false;
      }
    }

    // ----- 공개 대국 목록 요약: 누구나 읽기(관전·목록은 로그인 없이), 한 번에 50개까지. 쓰기는 Cloud Functions(syncLobby·cleanupLobby)만 -----
    match /games/janggi/lobby/{roomId} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow write: if false;
    }

    // ----- 사용자 (claimEmailLogin·revokeAllSessions·noteLogin이 씀). 로그인한 기기 목록(devices)도 여기 → 본인만 읽기 -----
    match /games/janggi/users/{uid} {
      allow read: if request.auth != null && me() == uid;
      allow write: if false;
    }

    // ----- 로그인 요청·남용 방지 기록: 클라이언트는 읽기·쓰기 모두 금지 (Cloud Functions의 Admin SDK는 규칙을 거치지 않음) -----
    // 승인 여부는 요청자에게도 직접 보이지 않는다. 요청자는 claimSecret을 들고 claimEmailLogin으로만 묻는다.
    match /games/janggi/loginRequests/{id} {
      allow read, write: if false;
    }
    match /games/janggi/loginEmails/{key} {
      allow read, write: if false;
    }
    match /games/janggi/loginIps/{key} {
      allow read, write: if false;
    }
    // 새 기기 알림 메일의 "모든 기기에서 로그아웃" 링크 (토큰 해시, 7일, 한 번만)
    match /games/janggi/revokeLinks/{id} {
      allow read, write: if false;
    }

    // ----- (메일 수단으로 Trigger Email 확장을 고른 경우) 확장이 읽는 mail 컬렉션도 클라이언트 금지 -----
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
