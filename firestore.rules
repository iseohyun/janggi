rules_version = '2';

// =====================================================================
// 웹장기 온라인 대국 Firestore 보안 규칙 초안 (아직 배포하지 않음)
//
//  - 데이터: games/janggi/rooms/{roomId}
//            games/janggi/rooms/{roomId}/moves/{ply}   (ply = 0부터 세는 수 번호, 문서 id = 그 숫자)
//            games/janggi/rooms/{roomId}/chat/{자동 id}
//  - 앱 코드: module/online/firebase-backend.js, online-core.js
//  - 이 Firebase 프로젝트(any-match-hub)는 다른 게임과 함께 쓸 수 있다.
//    Firestore 규칙은 데이터베이스마다 파일이 하나뿐이므로, 다른 게임 규칙이 이미 있으면
//    아래 "match /games/janggi/..." 부분만 그 파일의 match /databases/{database}/documents { } 안에 합쳐서 배포한다.
//    (그대로 배포하면 다른 게임의 규칙을 덮어쓴다!)
//  - 서버는 장기 규칙(기물 움직임)을 검사하지 않는다. 받는 쪽 앱이 기존 규칙 검사로 거부한다.
//    여기서는 "누가·언제·몇 번째 수를" 쓰는지만 지킨다.
//  - 시간패·외통 결과는 양쪽 앱이 보내는 값을 믿는다 (규칙으로 시계를 검증할 수 없음).
//  - "인증된 사용자" = Google 로그인 또는 이메일 숫자 코드 인증을 마친 사용자 (Cloud Functions verifyEmailCode가
//    emailVerified=true로 바꿈). 인증 전 계정은 초대받은 방 입장(과 그 방 안의 대국·채팅)만 할 수 있고 방을 만들 수 없다.
//  - games/janggi/emailCodes/{uid}(코드 해시·보내기 기록)는 Cloud Functions(Admin SDK)만 읽고 쓴다.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    // Google 로그인이거나 이메일 인증을 마친 "실제 사용자"
    function verified() {
      return request.auth != null
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function sideOf(ply) {
      return ply % 2 == 0 ? 'cho' : 'han';
    }

    function otherSide(side) {
      return side == 'cho' ? 'han' : 'cho';
    }

    function coord(v, min) {
      return v is int && v >= min && v <= 9;
    }

    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 40;
    }

    function roomDoc(database, roomId) {
      return /databases/$(database)/documents/games/janggi/rooms/$(roomId);
    }

    match /games/janggi/rooms/{roomId} {

      function isMember() {
        return signedIn() && me() in resource.data.members;
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function mySide() {
        return resource.data.seats.cho != null && resource.data.seats.cho.uid == me() ? 'cho' : 'han';
      }

      // 방 만든 뒤 바뀌면 안 되는 칸
      function fixedKept() {
        return !changed().hasAny(['app', 'v', 'hostUid', 'createdAtMs', 'createdAt', 'charim',
                                  'timeLimitMin', 'sidePick', 'members', 'seats']);
      }

      function moveDocAfter(ply) {
        return existsAfter(/databases/$(database)/documents/games/janggi/rooms/$(roomId)/moves/$(string(ply)));
      }

      // 읽기: 참가자, 또는 초대 링크로 들어오려는 로그인 사용자(기다리는 방만). 없는 방(resource == null)은 "없음"을 알 수 있게.
      // 목록 조회(list)는 막는다 → 방 코드를 모르면 찾을 수 없다.
      allow get: if signedIn() && (resource == null || me() in resource.data.members || resource.data.status == 'waiting');
      allow list: if false;

      // 방 만들기: 인증된 사용자만. 내가 방장이고 한 자리에만 앉는다
      allow create: if verified()
        && roomId.matches('^[A-Z0-9]{6,16}$')
        && request.resource.data.app == 'janggi'
        && request.resource.data.hostUid == me()
        && request.resource.data.members == [me()]
        && request.resource.data.status == 'waiting'
        && request.resource.data.ply == 0
        && request.resource.data.undo == null
        && request.resource.data.result == null
        && request.resource.data.timeLimitMin is int
        && request.resource.data.timeLimitMin >= 0 && request.resource.data.timeLimitMin <= 180
        && request.resource.data.charim.cho is int && request.resource.data.charim.cho >= 0 && request.resource.data.charim.cho <= 3
        && request.resource.data.charim.han is int && request.resource.data.charim.han >= 0 && request.resource.data.charim.han <= 3
        && ((request.resource.data.seats.han == null && request.resource.data.seats.cho.uid == me()
              && validName(request.resource.data.seats.cho.name))
            || (request.resource.data.seats.cho == null && request.resource.data.seats.han.uid == me()
              && validName(request.resource.data.seats.han.name)));

      // 입장: 참가자가 아닌 사람이 기다리는 방의 빈 자리에 자기를 앉히고 대국을 시작한다
      function joining() {
        let side = resource.data.seats.cho == null ? 'cho' : 'han';
        return signedIn()
          && !(me() in resource.data.members)
          && resource.data.status == 'waiting'
          && changed().hasOnly(['seats', 'members', 'status', 'startedAtMs', 'lastMoveAtMs'])
          && request.resource.data.members == resource.data.members.concat([me()])
          && request.resource.data.status == 'playing'
          && request.resource.data.seats[side].uid == me()
          && validName(request.resource.data.seats[side].name)
          && request.resource.data.seats[otherSide(side)] == resource.data.seats[otherSide(side)];
      }

      // 참가자가 바꿀 수 있는 것
      function memberUpdate() {
        let o = resource.data;
        let d = request.resource.data;
        return isMember() && fixedKept() && (
          // ① 수 하나 두기: 자기 차례의 자리 주인이, moves/{ply} 문서와 함께 (한 트랜잭션)
          (o.status == 'playing'
            && d.ply == o.ply + 1
            && o.seats[sideOf(o.ply)].uid == me()
            && moveDocAfter(o.ply)
            && changed().hasOnly(['ply', 'clock', 'lastMoveAtMs', 'undo', 'status', 'result'])
            && d.undo == null
            && (d.status == 'playing'
                || (d.status == 'ended' && d.result.reason == 'checkmate'
                    && d.result.winner == mySide() && d.result.by == me())))
          // ② 무르기 받아들이기: 상대가 청한 무르기를, 마지막 수 문서를 지우면서
          || (o.status == 'playing'
            && o.undo != null && o.undo.by != me() && o.undo.ply == o.ply
            && d.ply == o.ply - 1
            && !moveDocAfter(o.ply - 1)
            && changed().hasOnly(['ply', 'undo', 'lastMoveAtMs'])
            && d.undo == null)
          // ③ 무르기 청하기: 방금 둔 내 수만
          || (o.status == 'playing'
            && o.undo == null && o.ply > 0
            && o.seats[sideOf(o.ply - 1)].uid == me()
            && changed().hasOnly(['undo'])
            && d.undo.by == me() && d.undo.ply == o.ply)
          // ④ 무르기 거절: 상대가 청한 것을 지운다
          || (o.undo != null && o.undo.by != me()
            && changed().hasOnly(['undo'])
            && d.undo == null)
          // ⑤ 대국 끝: 기권(내가 짐)·시간패
          || (o.status == 'playing' && d.status == 'ended'
            && changed().hasOnly(['status', 'result', 'clock', 'undo'])
            && d.result.by == me()
            && ((d.result.reason == 'resign' && d.result.winner == otherSide(mySide()))
                || (d.result.reason == 'timeout' && d.result.winner in ['cho', 'han'])))
          // ⑥ 방장이 상대를 기다리던 방 닫기
          || (o.status == 'waiting' && o.hostUid == me()
            && d.status == 'closed'
            && changed().hasOnly(['status']))
        );
      }

      allow update: if joining() || memberUpdate();
      allow delete: if false;

      // ----- 수 -----
      match /moves/{moveId} {
        function room() {
          return get(roomDoc(database, roomId)).data;
        }

        function roomAfter() {
          return getAfter(roomDoc(database, roomId)).data;
        }

        allow read: if signedIn() && me() in room().members;

        // 자기 차례에 자기 수만, 방의 수 번호를 하나 올리면서
        allow create: if signedIn()
          && me() in room().members
          && room().status == 'playing'
          && room().seats[sideOf(room().ply)].uid == me()
          && moveId == string(room().ply)
          && request.resource.data.ply == room().ply
          && request.resource.data.by == me()
          && roomAfter().ply == room().ply + 1
          && coord(request.resource.data.fx, 1) && coord(request.resource.data.fy, 0)
          && coord(request.resource.data.tx, 1) && coord(request.resource.data.ty, 0)
          && request.resource.data.keys().hasOnly(['ply', 'by', 'fx', 'fy', 'tx', 'ty', 'clock', 'atMs', 'at']);

        // 무르기 받아들이기: 상대가 청한 마지막 수만, 방 수 번호를 하나 내리면서
        allow delete: if signedIn()
          && me() in room().members
          && room().undo != null && room().undo.by != me()
          && moveId == string(room().ply - 1)
          && roomAfter().ply == room().ply - 1;

        allow update: if false;
      }

      // ----- 채팅 -----
      match /chat/{msgId} {
        function room() {
          return get(roomDoc(database, roomId)).data;
        }

        allow read: if signedIn() && me() in room().members;

        allow create: if signedIn()
          && me() in room().members
          && request.resource.data.uid == me()
          && request.resource.data.kind in ['user', 'system']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && validName(request.resource.data.name)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'side', 'text', 'kind', 'atMs', 'at']);

        allow update, delete: if false;
      }
    }

    // ----- 사용자 등록 (verifyEmailCode가 씀) -----
    match /games/janggi/users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if false;
    }

    // ----- 인증 코드 기록: 클라이언트는 읽기·쓰기 모두 금지 (Cloud Functions의 Admin SDK는 규칙을 거치지 않음) -----
    match /games/janggi/emailCodes/{uid} {
      allow read, write: if false;
    }

    // ----- (메일 수단으로 Trigger Email 확장을 고른 경우) 확장이 읽는 mail 컬렉션도 클라이언트 금지 -----
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
