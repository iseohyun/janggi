# 웹장기 Cloud Functions 설정값 (비밀값 아님 → 저장소에 둬도 됨)
# 비밀값(Resend API 키)은 여기에 넣지 않는다: firebase functions:secrets:set MAIL_SECRET
# 문서: docs/online-setup.md 7장

MAIL_PROVIDER=resend

# 보내는 사람. Resend에서 인증을 마친 도메인의 주소여야 한다.
# 2026-11-20 사용자 확정.
MAIL_FROM=웹장기 <noreply@iseohyun.com>

# 승인 메일 링크에 쓸 배포 주소 (쉼표로 여러 개). localhost·127.0.0.1은 개발용으로 늘 허용한다.
APP_ORIGINS=https://janggi.iseohyun.com
